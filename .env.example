BOT_TOKEN=your_telegram_bot_token_from_botfather
WEBAPP_URL=https://your-deployed-server-url.com
# Numeric Telegram ids of the administrators, comma separated (ask @userinfobot). Empty = nobody is admin.
TEACHER_IDS=
CHANNEL_ID=@your_telegram_channel
PORT=8080
# Optional: where the SQLite database lives (use a persistent disk in production)
# DB_PATH=/data/level_one.db

# Self-registration is closed by default (students use Telegram or a teacher's roster entry). 1 = anyone may register.
# ALLOW_SELF_REGISTRATION=0
# Students enter with a name, an avatar and a level (no password). 0 = close that door (Telegram and the teacher's class list stay).
# OPEN_JOIN=1
# Extra proxy IPs (comma separated) whose X-Forwarded-For / CF-Connecting-IP headers are trusted. Loopback and private addresses already are.
# TRUSTED_PROXIES=
