# Secrets and local data must never be committed
.env
.env.*
!.env.example
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite*
*.log
*.bak
*.bak.*
*.before_plain_patch
__pycache__/
*.pyc

# Telegram profile photos downloaded by the bot (personal data of the users)
avatars/

# Local tooling and tunnel files
.impeccable/
current_tunnel_url.txt
tunnel_out*

# Teaching material taken from the teacher's PDF books (copyrighted).
# Rebuild it locally from the PDFs with tools/extract_books.py
books/
static/img/grammar/
static/img/vocab/
static/img/books_manifest.json

# Recorded voice clips (switched off in dragon_chase.js, PLAY_VOICE_LINES = false)
static/sfx/*.mp3

# Installed JavaScript packages are never committed
node_modules/

# 3D bundle tooling (rebuild static/l1_3d.js with: cd tools/3d_src; npm install; npm run build)
tools/3d_src/node_modules/

# Database copies made by the server every few hours
backups/
